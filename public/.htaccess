Options -MultiViews
RewriteEngine On

# Sin esto Apache sirve los .md como octet-stream (el navegador los descarga).
AddType text/markdown .md
AddDefaultCharset UTF-8

# ── MIME types de documentos descargables ─────────────────────────────────────
# El Apache de Hostinger NO tiene registrados los tipos de Office: servía
# /assets/documents/declaracion-jurada.xlsx como "text/plain; charset=UTF-8" y,
# combinado con el X-Content-Type-Options: nosniff de más abajo (que le prohíbe
# al navegador deducir el tipo real), Chrome mostraba el binario del ZIP como
# texto en pantalla en vez de descargarlo. Los .pdf sí venían correctos.
AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet   .xlsx
AddType application/vnd.ms-excel                                            .xls
AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
AddType application/msword                                                  .doc

# Un Excel no se puede "ver" en el navegador: siempre es una descarga. Se fuerza
# el attachment para que el nombre del archivo sea explícito y no dependa de
# cómo cada navegador interprete el tipo.
<IfModule mod_headers.c>
  <FilesMatch "\.(xlsx|xls|docx|doc)$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>

# ── Preservar rutas del sistema existente ──────────────────────────────────────
RewriteRule ^pack-sistema(/.*)?$  - [L]
RewriteRule ^pages(/.*)?$         - [L]
RewriteRule ^PHPMailer(/.*)?$     - [L]
RewriteRule ^tienda(/.*)?$        - [L]
RewriteRule ^assets(/.*)?$        - [L]

# ── Negociación de contenido de la home (acceptmarkdown.com) ──────────────────
# La home pasa por un negociador PHP que sirve text/markdown a quien lo pida por
# Accept, HTML al resto, 406 si no acepta ninguno de los dos, y SIEMPRE emite
# `Vary: Accept` para que un CDN no cruce las variantes cacheadas.
# Va antes de la regla de archivos físicos porque "/" resuelve a index.html, que
# es un archivo físico y saldría por [L] sin llegar acá.
RewriteRule ^$  /_agent/negotiate.php  [E=PE_MODE:home,L]

# ── Archivos y carpetas físicas pasan directo ─────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Sin catch-all: Apache genera 404 natural para rutas desconocidas ──────────
# El 404 también se negocia: un navegador sigue viendo la SPA (con status 404
# real), y un agente recibe un cuerpo markdown con adónde ir. Ver negotiate.php.
ErrorDocument 404 /_agent/404.php

# ── Vary: Accept en las respuestas estáticas ──────────────────────────────────
# mod_deflate ya agrega `Vary: Accept-Encoding`; acá se AÑADE Accept (append, no
# set, para no pisarlo). Sin esto un CDN podría servirle la variante equivocada
# a un agente según cuál cayó primero en caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|md)$">
    Header append Vary "Accept"
  </FilesMatch>
</IfModule>

# ══════════════════════════════════════════════════════════════════════════════
# SECURITY HEADERS
# ══════════════════════════════════════════════════════════════════════════════
<IfModule mod_headers.c>

  # ── Headers universales (aplican a todo, incluso sistema legacy) ──────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # ── Headers estrictos solo para el SPA React (no afectan pack-sistema etc.) ───
  <If "! %{REQUEST_URI} =~ m#^/(pack-sistema|pages|tienda|PHPMailer|assets)(/|$)#">

    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

    # Content Security Policy — solo para el landing React
    # Three.js texture auto-hospedada en /textures/worldMap.png
    Header always set Content-Security-Policy "\
      default-src 'self'; \
      script-src 'self' https://www.googletagmanager.com; \
      style-src 'self' 'unsafe-inline'; \
      font-src 'self'; \
      img-src 'self' data: https: blob:; \
      connect-src 'self' https://maps.googleapis.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; \
      frame-src https://maps.google.com https://www.google.com; \
      object-src 'none'; \
      base-uri 'self'; \
      form-action 'self'; \
      upgrade-insecure-requests;"

  </If>

</IfModule>

# ══════════════════════════════════════════════════════════════════════════════
# COMPRESIÓN BROTLI / GZIP
# ══════════════════════════════════════════════════════════════════════════════
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml text/xml
  AddOutputFilterByType BROTLI_COMPRESS font/woff2 font/woff application/font-woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml text/xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff2
</IfModule>

# ══════════════════════════════════════════════════════════════════════════════
# CACHE HEADERS
# ══════════════════════════════════════════════════════════════════════════════
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — sin caché (siempre fresco)
  ExpiresByType text/html                  "access plus 0 seconds"

  # Assets con hash en el nombre — caché agresivo 1 año
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/css                   "access plus 1 year"

  # Fuentes
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType application/font-woff2     "access plus 1 year"

  # Imágenes
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 month"
  ExpiresByType image/jpeg                 "access plus 1 month"
  ExpiresByType image/webp                 "access plus 1 month"

  # Manifesto y SEO
  ExpiresByType application/manifest+json  "access plus 1 week"
  ExpiresByType application/json           "access plus 0 seconds"
  ExpiresByType text/xml                   "access plus 1 day"
</IfModule>

# Cache-Control headers adicionales para assets con hash
<FilesMatch "\.(js|css|woff2|woff|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML nunca se cachea
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Sitemap, robots, llms — caché corto
<FilesMatch "(sitemap\.xml|robots\.txt|llms\.txt)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
