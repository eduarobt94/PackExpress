# Google Analytics 4 — ver docs/GOOGLE_ANALYTICS_IMPLEMENTATION_PLAN.md
# Copiar a .env.production (propiedad real) y/o .env.development (propiedad de pruebas).
# El ID de medición es público (queda embebido en el bundle); no es un secreto.
# Sin VITE_GA_MEASUREMENT_ID la analítica queda desactivada y no se muestra el banner.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Solo en .env.development / pruebas: permite enviar desde localhost y activa
# debug_mode para verlo en DebugView. NUNCA en .env.production.
# VITE_GA_DEBUG=1
